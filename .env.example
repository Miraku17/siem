# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://siem:siem@localhost:5432/siem?schema=public"
# Direct (non-pooled) connection for Prisma migrations. Locally == DATABASE_URL;
# in prod (Neon) DATABASE_URL is pooled and DIRECT_URL is the direct string.
DIRECT_URL="postgresql://siem:siem@localhost:5432/siem?schema=public"

# ── Redis (optional) ──────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ───────────────────────────────────────────────────
API_PORT=4000
# WEB_ORIGIN restricts CORS in production, e.g. https://your-siem.vercel.app
# WEB_ORIGIN="http://localhost:3000"

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# ── Web ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
