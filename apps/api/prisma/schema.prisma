// SIEM Platform — Prisma schema
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel = Vercel serverless (Amazon Linux); debian = Render.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled (DATABASE_URL) for runtime; direct (DIRECT_URL) for migrations.
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

// Analyst's verdict after triage — separate from workflow status.
enum AlertDisposition {
  BENIGN
  FALSE_POSITIVE
  TRUE_POSITIVE_NO_IMPACT
  TRUE_POSITIVE
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

// Event types are stored as strings so applications can send new types
// without a migration. See src/events/event-types.ts for the known catalog.

// ── Models ─────────────────────────────────────────────────

model Application {
  id   String @id @default(cuid())
  name String
  slug String @unique // e.g. "velocity-pickleball"
  // SHA-256 of the issued key. The plaintext is shown once at registration and
  // never stored, so a database dump can't be used to impersonate a source app.
  apiKeyHash String            @unique
  keyPrefix  String // first chars of the key, for display ("sk_live_a1b2c3…")
  status     ApplicationStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())

  events SecurityEvent[]

  @@map("applications")
}

model SecurityEvent {
  id            String   @id @default(cuid())
  applicationId String
  eventType     String
  severity      Severity @default(LOW)
  userId        String?
  email         String?
  ipAddress     String?
  endpoint      String?
  method        String?
  statusCode    Int?
  userAgent     String?
  timestamp     DateTime // when the event occurred (from the source app)
  metadata      Json?
  createdAt     DateTime @default(now()) // when the SIEM ingested it

  application Application @relation(fields: [applicationId], references: [id])
  alerts      Alert[]

  @@index([timestamp]) // paginated event list orders by timestamp with no filter
  @@index([applicationId, timestamp])
  @@index([eventType, timestamp])
  @@index([ipAddress])
  @@index([userId])
  @@index([email])
  @@map("security_events")
}

model Alert {
  id          String            @id @default(cuid())
  title       String
  severity    Severity
  status      AlertStatus       @default(OPEN)
  disposition AlertDisposition? // analyst verdict after triage
  description String?
  ruleId      String? // which detection rule fired
  eventId     String?
  incidentId  String?
  createdAt   DateTime          @default(now())

  event    SecurityEvent? @relation(fields: [eventId], references: [id])
  incident Incident?      @relation(fields: [incidentId], references: [id])
  comments AlertComment[]

  @@index([severity, status])
  @@index([createdAt])
  @@map("alerts")
}

model AlertComment {
  id        String   @id @default(cuid())
  alertId   String
  author    String // analyst email
  body      String
  createdAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("alert_comments")
}

model Incident {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      IncidentStatus   @default(OPEN)
  priority    IncidentPriority @default(MEDIUM)
  assignedTo  String? // User id
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignee User?   @relation(fields: [assignedTo], references: [id])
  alerts   Alert[]

  @@index([status, priority])
  @@map("incidents")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String // hashed
  role      UserRole   @default(ANALYST)
  createdAt DateTime   @default(now())

  incidents Incident[]

  @@map("users")
}
